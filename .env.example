# Токен от @BotFather
BOT_TOKEN=123456:ABC...

# --- Telegram webhook ---
# Публичный HTTPS-адрес (через nginx). Пусто = режим long polling (для локального запуска)
WEBHOOK_BASE_URL=https://bot.example.com
WEBHOOK_PATH=/tg/webhook
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token (A-Z a-z 0-9 _ -)
WEBHOOK_SECRET=change_me_to_random_string
WEB_HOST=0.0.0.0
WEB_PORT=8080

# --- Приём данных от CS2 (Game State Integration) ---
GSI_HOST=0.0.0.0
GSI_PORT=30000
# Адрес, который попадёт в cfg игроков: IP/домен сервера + порт 30000
GSI_PUBLIC_URL=http://203.0.113.10:30000/
# Папка для сырых логов GSI (для отладки). Пусто = не писать
GSI_DUMP_DIR=
# 1 = присылать короткое сообщение после каждого раунда
LIVE_ROUND_UPDATES=0

DB_PATH=data/bot.sqlite3
